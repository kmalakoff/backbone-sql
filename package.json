{
  "name": "backbone-sql",
  "version": "0.6.6",
  "description": "SQLite and selected PostgreSQL persistence for BackboneORM; MySQL pending",
  "keywords": [
    "backbone",
    "orm",
    "backbone-orm",
    "sql",
    "mysql",
    "postgres",
    "pg",
    "sqlite",
    "sqlite3"
  ],
  "repository": {
